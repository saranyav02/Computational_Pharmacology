model{

  #--------------------------------------------------
  # Observation model
  #--------------------------------------------------
#N=number of subjects
#M= umber of observations

  for(i in 1:N){
    #distribution of indivdual parameters
    phi[i,1:2] ~ dmnorm(theta[], OmegaInv[,])

	#vector of individual parameters
    CL[i] <- phi[i,1]
    V[i]  <- phi[i,2]

    for(j in 1:M){
	#define model (f) 
      Cpred[i,j] <- Dose[i]/V[i] *exp(-(CL[i]/V[i])*Time[j])

	#observational model
      y[i,j] ~ dnorm(Cpred[i,j], tau)
    }
  }
 #
  # Priors
  #
  #mean parameter values
  theta[1:2] ~ dmnorm(mu0[], SigmaInv[,])

  #patient heterogeneity
  OmegaInv[1:2,1:2] ~ dwish(R[,], rho)
  Omega[1:2,1:2] <- inverse(OmegaInv[,])

  #residual error
  sigma ~ dunif(0,10)
  tau <- pow(sigma,-2)
}

#---------------------------------------------
#Data
#---------------------------------------------
list(
N= 3, #number of subjects
M = 4, #number of observations
Dose = c(100,100,100),
Time = c(1,2,4,8),
y = structure(
.Data = c(
7.8,6.3,4.2,1.8, #observations for patient 1
8.5,6.9,4.5,2.0, #observations for patient 2
6.9,5.5,3.4,1.3 #observations for patient 3
),
.Dim = c(3,4)
),
mu0 = c(10,20), 
SigmaInv = structure(
.Data = c(
0.01,0,
0,0.01
),
.Dim = c(2,2)
),
R = structure(
.Data = c(0.25,0,0,0.25),
.Dim = c(2,2)
),

rho = 3

)
